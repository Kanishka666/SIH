# Copy this file to .env and adjust as needed.

# ---- General ----
APP_NAME=LabelLens API
APP_VERSION=0.1.0
ENVIRONMENT=development

# ---- JWT / Auth ----
# IMPORTANT: change this to a long random string in any real deployment.
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://label-lens.ai.studio

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Backend-only integrations ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
OCR_API_URL=
